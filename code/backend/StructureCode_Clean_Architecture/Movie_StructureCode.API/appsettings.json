      "Default": "Warning",

      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Movie_StructureCode": "Information"
      }
    },

    "WriteTo": [
      {
        "Name": "Console",

        "Args": {
          "Theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },

      {
        "Name": "File",

        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ],

    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },

